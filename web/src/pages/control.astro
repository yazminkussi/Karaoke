---
import Base from '../layouts/Base.astro';
---

<Base title="Karaoke · Control">
  <div class="wrap">
    <header>
      <span id="dot" class="dot"></span>
      <span id="estadoLabel">conectando…</span>
    </header>

    <main>
      <section class="vista" data-estado="ESPERANDO">
        <h1>Tu era popstar te espera</h1>
        <p>Acercate a la pantalla o tocá el botón para empezar.</p>
        <button class="grande" data-accion="presencia">Estoy listx</button>
      </section>

      <section class="vista" data-estado="SELECCIONANDO">
        <h2>Elegí tu canción</h2>
        <div class="scroll-btns">
          <button data-accion="scroll" data-dir="arriba">▲</button>
          <button data-accion="scroll" data-dir="abajo">▼</button>
        </div>
        <ul id="lista"></ul>
        <button class="grande" data-accion="confirmar">Confirmar</button>
        <button class="link" data-accion="reset">Cancelar</button>
      </section>

      <section class="vista" data-estado="CONFIRMADA">
        <h2 id="confTitulo">Preparando…</h2>
        <p>Mirá la pantalla principal 👀</p>
      </section>

      <section class="vista" data-estado="COUNTDOWN">
        <div id="cd">3</div>
      </section>

      <section class="vista" data-estado="PLAYING">
        <h2>¡Estás en vivo!</h2>
        <p>Cantala fuerte.</p>
        <div class="reactions">
          <button data-fb="¡Muy bien!">👏</button>
          <button data-fb="Sos una estrella">⭐</button>
          <button data-fb="Corazón">💖</button>
        </div>
        <button class="link" data-accion="interrupcion">Terminar ahora</button>
      </section>

      <section class="vista" data-estado="RESULTADO">
        <h1>¡Un éxito, popstar!</h1>
        <div id="score">0</div>
        <p>Escaneá el QR de la pantalla para llevarte tu video.</p>
        <button class="grande" data-accion="reset">Volver al inicio</button>
      </section>
    </main>
  </div>

  <style>
    body { overflow: auto; background: linear-gradient(160deg, #150b2e, #0a0a12); }
    .wrap { max-width: 480px; margin: 0 auto; min-height: 100%; }
    header { display: flex; align-items: center; gap: 8px; padding: 12px 16px; font-size: .85rem; opacity: .85; }
    .dot { width: 10px; height: 10px; border-radius: 50%; background: #b00020; transition: background .3s; }
    .dot.on { background: var(--cian); }
    main { padding: 16px; }
    .vista { display: none; flex-direction: column; gap: 16px; text-align: center; }
    body[data-estado="ESPERANDO"]     .vista[data-estado="ESPERANDO"],
    body[data-estado="SELECCIONANDO"] .vista[data-estado="SELECCIONANDO"],
    body[data-estado="CONFIRMADA"]    .vista[data-estado="CONFIRMADA"],
    body[data-estado="COUNTDOWN"]     .vista[data-estado="COUNTDOWN"],
    body[data-estado="PLAYING"]       .vista[data-estado="PLAYING"],
    body[data-estado="RESULTADO"]     .vista[data-estado="RESULTADO"] { display: flex; }
    h1 { font-size: 1.6rem; } h2 { font-size: 1.3rem; } p { opacity: .8; }
    button { font: inherit; color: #fff; border: 0; border-radius: 14px; padding: 14px 18px; background: rgba(255,255,255,.1); }
    button:active { transform: scale(.97); }
    .grande { background: linear-gradient(90deg, var(--rosa), var(--violeta)); font-size: 1.2rem; font-weight: 700; padding: 18px; }
    .link { background: none; opacity: .6; text-decoration: underline; }
    .scroll-btns { display: flex; gap: 12px; }
    .scroll-btns button { flex: 1; font-size: 1.5rem; padding: 18px; }
    #lista { list-style: none; display: flex; flex-direction: column; gap: 8px; }
    #lista li { padding: 12px 14px; border-radius: 12px; background: rgba(255,255,255,.06); font-size: .95rem; }
    #lista li.activa { background: linear-gradient(90deg, var(--rosa), var(--violeta)); font-weight: 700; }
    .reactions { display: flex; gap: 12px; }
    .reactions button { font-size: 2rem; flex: 1; padding: 16px 0; }
    #cd { font-size: 6rem; font-weight: 900; }
    #score { font-size: 4rem; font-weight: 900; background: linear-gradient(90deg, var(--rosa), var(--cian)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  </style>

  <script>
    import '../lib/control.js';
  </script>
</Base>
