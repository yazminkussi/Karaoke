---
import Base from '../layouts/Base.astro';
---

<Base title="Karaoke · Pantalla principal">
  <canvas id="gl"></canvas>
  <video id="selfCam" autoplay playsinline muted></video>
  <div id="filtro"></div>
  <div id="vineta"></div>
  <audio id="pista" preload="auto"></audio>

  <div id="feedbackFlash"></div>

  <!-- indicador de escucha por voz -->
  <div id="vozBox">🎙️ <span id="vozStatus">iniciando…</span></div>

  <!-- ESPERANDO -->
  <section class="ui" data-estado="ESPERANDO">
    <h1>Sentite un cantante profesional</h1>
    <p class="lead">Levantá la mano o decí <b>"cantar"</b> para vivir tu era popstar</p>
  </section>

  <!-- SELECCIONANDO -->
  <section class="ui" data-estado="SELECCIONANDO">
    <h2>Elegí tu canción</h2>
    <p class="hint">Mano arriba / abajo o decí el nombre · pellizcá o decí "confirmar"</p>
  </section>

  <!-- CONFIRMADA -->
  <section class="ui" data-estado="CONFIRMADA">
    <h2>Preparando el escenario…</h2>
    <p class="lead" id="confirmadaTitulo"></p>
  </section>

  <!-- COUNTDOWN -->
  <section class="ui" data-estado="COUNTDOWN">
    <div id="countdownNum">3</div>
  </section>

  <!-- PLAYING: la letra la dibuja Three.js -->
  <section class="ui" data-estado="PLAYING"></section>

  <!-- RESULTADO -->
  <section class="ui" data-estado="RESULTADO">
    <h1>¡Un éxito, popstar!</h1>
    <div id="puntajeFinal">0</div>
    <img id="qrResultado" class="qr" alt="QR para descargar tu video" />
    <p class="hint">Escaneá para llevarte tu video</p>
  </section>

  <script>
    import '../lib/pantalla.js';
  </script>
</Base>
